# Copy this file to .env for local development (never commit .env)

# Neon connection string (Neon dashboard > Connect). Leave empty to use local SQLite.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Password for /admin
ADMIN_PASSWORD=change-me-too

# Shown on the success page after someone joins the waitlist
WHATSAPP_LINK=https://chat.whatsapp.com/your-group-link

# Branding / event details
EVENT_PARTNER=8Digits Komputers
EVENT_PROGRAM=NextGen Skill
EVENT_HEADLINE=Free 3 Weeks of Impact
EVENT_NAME=Hotspot Learning Hub
EVENT_TAGLINE=Open to every student. Every level. Every department. Every college.
EVENT_DATE=
# Set BOTH date and venue to replace the "date and venue will be communicated soon" banner
EVENT_VENUE=
